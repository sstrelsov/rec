# rec - .gitignore

# Captured data (sensitive - never commit)
*.mitm
*.log

# Status files
.pid
.active
.last_capture
.last_organized
.mitmdump.pid

# mitmproxy
.mitmproxy/
mitmproxy-ca-cert.pem

# Output directories
output/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
htmlcov/

# Virtual environments
.env
.venv
env/
venv/

# macOS
.DS_Store
._*

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Secrets
.env.local
.env.*.local
secrets.json
credentials.json
*.pem
*.key
*.crt

# Archives
*.7z
*.gz
*.tar
*.zip
*.bak

# Examples directory
examples/
